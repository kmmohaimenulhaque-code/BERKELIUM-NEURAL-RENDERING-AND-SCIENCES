new file mode 100644
index 0000000..b30ab3e
--- /dev/null
+++ b/scripts/solver_sweep.py
@@ -0,0 +1,51 @@
+"""Exhaustive ModelEnv solve sweep (ADR-026 evidence; reproducible). For every benchmark task (seed 0) and every
+subset of <= K usable library fragments, run the agent-model solve and record the status (or the exception).
+
+ python scripts/solver_sweep.py --k 2 --split all --out out/sweep_k2_all.jsonl # 31.6k solves, ~2-4 min CPU
+ python scripts/solver_sweep.py --k 3 --split train --out out/sweep_k3_train.jsonl # 181k solves, ~45 min CPU
+Exit code 1 if any solve raised. To compare two code versions, run each checkout with CODE_ROOT=<checkout>."""
+import argparse
+import itertools
+import json
+import os
+import sys
+from collections import Counter
+
+if os.environ.get("CODE_ROOT"): # evaluate a specific checkout (bypasses an editable install's finder)
+ sys.meta_path = [f for f in sys.meta_path if "editable" not in repr(f).lower()]
+ sys.path.insert(0, os.environ["CODE_ROOT"])
+
+
+def main(argv=None):
+ from berkelium.agent.model_env import QUARANTINED, ModelEnv
+ from berkelium.agent.model_tasks import tasks
+ from berkelium.synthesis.library import FRAGMENTS_SRC
+ ap = argparse.ArgumentParser()
+ ap.add_argument("--k", type=int, default=2)
+ ap.add_argument("--split", choices=["train", "heldout", "all"], default="all")
+ ap.add_argument("--out", default=None)
+ a = ap.parse_args(argv)
+ frs = [f.relation.id for f in FRAGMENTS_SRC if f.relation.id not in QUARANTINED]
+ out = open(a.out, "w") if a.out else None
+ counts, n = Counter(), 0
+ for t in tasks(4, seed=0):
+ if a.split != "all" and t.split != a.split:
+ continue
+ for size in range(1, a.k + 1):
+ for combo in itertools.combinations(frs, size):
+ env = ModelEnv(t)
+ env.model = list(combo)
+ try:
+ rec = {"status": env._solve()["status"]}
+ except Exception as e: # noqa: BLE001 - the point of the sweep is to find these
+ rec = {"exception": f"{type(e).__name__}: {str(e)[:120]}"}
+ counts[rec.get("status") or "EXCEPTION " + rec["exception"][:60]] += 1
+ n += 1
+ if out:
+ out.write(json.dumps({"task": t.id, "model": combo, **rec}) + "\n")
+ print(json.dumps({"solves": n, "k": a.k, "split": a.split, "counts": dict(counts)}, indent=1))
+ return 1 if any(k.startswith("EXCEPTION") for k in counts) else 0
+
+
+if __name__ == "__main__":
+ sys.exit(main())
