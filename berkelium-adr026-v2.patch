+"""ADR-026 regressions: the MI300X eval crash (log() domain error in a coupled solve), domain-aware solving,
+and the evaluation runner's failure policy (isolate, record, exclude, list, retry, re-validate)."""
+import dataclasses
+import json
+import sys
+
+import pytest
+
+from berkelium.agent.batch_runner import SUITES, replay, run_batched, run_policy
+from berkelium.agent.model_env import BY_ID, ModelEnv
+from berkelium.agent.model_tasks import tasks as model_tasks
+from berkelium.expr import ExprError
+from berkelium.laws import LawSet, Relation, Var, solve
+from berkelium.laws.core import _roots_1d
+from berkelium.synthesis.library import VARS
+from berkelium.units import Quantity as Q
+
+sys.path.insert(0, "scripts")
+PIPE = [t for t in model_tasks(4, seed=0) if t.id.startswith("pipe_")]
+
+
+# ------------------------------------------------------------------------------------------- the reproducer
+def test_exact_mi300x_reproducer_no_longer_crashes():
+ """M1, model_seen: the agent's model {colebrook, laminar_friction} made Powell's method step to Re < 0, where
+ Colebrook's log argument is negative -> ExprError escaped the environment and killed the run."""
+ assert len(PIPE) == 12
+ for t in PIPE:
+ env = ModelEnv(t)
+ for r in ("colebrook", "laminar_friction"):
+ env.step({"type": "add", "id": r})
+ obs, reward, done, _ = env.step({"type": "solve"})
+ rep = obs["last_solve"]
+ assert rep["status"] == "invalid_domain" and reward == 0.0 and not done
+ assert "violate validity/bounds" in rep["diagnostics"][-1] and "left the expression domain" in rep["diagnostics"][-1]
+
+
+def test_the_unguarded_strategy_really_leaves_the_domain():
+ """Documents the mechanism: plain Powell from the original x0 evaluates Colebrook at Re < 0."""
+ from scipy.optimize import root
+ t = next(x for x in PIPE if x.id == "pipe_turbulent_dp#0")
+ rels = [BY_ID["colebrook"].relation, BY_ID["laminar_friction"].relation]
+ seen = []
+
+ def F(x):
+ seen.append(tuple(x))
+ e = {**t.known, "f_D": Q(x[0], (0,) * 7), "Re": Q(x[1], (0,) * 7)}
+ return [r.residual(e) for r in rels]
+ with pytest.raises(ExprError, match="log"):
+ root(F, [1.0, 1.0], method="hybr", options={"xtol": 1e-14})
+ assert seen[-1][1] < 0 # Re < 0 although the model declares Re >= 0
+
+
+def test_math_unchanged_both_intersections_found_and_verified():
+ """Without validity conditions the same system has exactly the two laminar/Colebrook intersections, each
+ satisfying both equations; validity (Colebrook needs Re >= 4000) is what rejects them in the benchmark."""
+ t = next(x for x in PIPE if x.id == "pipe_turbulent_dp#0")
+ rels = [dataclasses.replace(BY_ID[r].relation, validity=()) for r in ("colebrook", "laminar_friction")]
+ names = set().union(*(r.vars for r in rels)) | set(t.known)
+ s = solve(LawSet("no_validity", {n: VARS[n] for n in names}, rels), t.known)
+ assert s.status == "ambiguous" and "2 admissible roots" in s.diagnostics[-1]
+ for f, re in ((0.061900525631, 1033.916906971574), (591.385922954006, 0.108220364259)):
+ e = {**t.known, "f_D": Q.of(f), "Re": Q.of(re)}
+ assert all(abs(r.residual(e)) < 1e-9 for r in rels)
+ assert abs(f - 64 / re) < 1e-9 * f
+
+
+# ------------------------------------------------------------------------------------ domain-aware solving
+def _ls(vars_, rels):
+ return LawSet("t", {v.name: v for v in vars_}, [Relation(f"r{i}", r) for i, r in enumerate(rels)])
+
+
+def test_coupled_root_outside_declared_bounds_is_not_accepted():
+ """x*y = 4, x = y with x, y <= 0 declared: Powell from x0 = (1, 1) converges to (2, 2), which the old code
+ accepted. Declared bounds are part of the model: the admissible root is (-2, -2)."""
+ s = solve(_ls([Var("x", "1", None, 0.0), Var("y", "1", None, 0.0), Var("k", "1")], ["x*y == k", "x == y"]),
+ {"k": Q.of(4.0)})
+ assert s.status == "solved" and abs(s.get("x", "1") + 2) < 1e-9 and abs(s.get("y", "1") + 2) < 1e-9
+ assert "outside declared bounds" in s.diagnostics[-1]
+
+
+def test_coupled_system_without_real_solution_is_not_converged_not_no_root():
+ s = solve(_ls([Var("x"), Var("y"), Var("k")], ["x*x + y*y == k", "x == y"]), {"k": Q.of(-1.0)})
+ assert s.status == "not_converged" and "no solution found" in s.diagnostics[-1]
+
+
+def test_scalar_bracket_straddling_a_domain_hole_is_skipped_not_raised():
+ def f(x):
+ if 2.9999 < x < 3.0001:
+ raise ExprError("log(): math domain error")
+ return x - 3.0
+ assert _roots_1d(f, 1.0, 10.0) == [] # root lies inside the hole: no continuous root to report
+
+
+def test_redundant_equation_undefined_at_solution_is_an_explicit_conflict():
+ s = solve(_ls([Var("x"), Var("y")], ["y == 2*x", "y == log(x)"]), {"x": Q.of(-1.0)})
+ assert s.status == "conflict"
+ assert any(c.kind == "consistency" and c.status == "fail" and "undefined at the solution" in c.detail
+ for c in s.checks)
+
+
+# ------------------------------------------------------------------------------------------- runner policy
+def _claim_tasks(n):
+ from agent_llm_eval import select
+ return select("heldout")[:n]
+
+
+def _replay_claim(batch):
+ from berkelium.agent import CheapestSufficient
+ return [json.dumps(CheapestSufficient().act(json.loads(m[1]["content"]))) for m in batch]
+
+
+@pytest.fixture
+def failing_env(monkeypatch):
+ """ClaimEnv whose step raises (a stand-in for any deterministic-core defect) for ONE task id."""
