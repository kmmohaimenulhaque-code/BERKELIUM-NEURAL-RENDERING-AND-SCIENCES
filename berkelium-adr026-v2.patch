+def test_incident_end_to_end_model_seen_completes_resumes_and_writes_summary(tmp_path):
+ """The MI300X incident through the real evaluator path: an 'M1' that builds {colebrook, laminar_friction} on
+ every pipe task, resumed on top of saved episodes. The suite completes, keeps the saved work, writes summary.md."""
+ import eval_generations as eg
+
+ from berkelium.agent.model_policies import ConstructorPolicy
+ ts = [t for t in model_tasks(4, seed=0) if t.split == "train"]
+ crash_seq = [{"type": "search", "var": "f_D"}, {"type": "add", "id": "laminar_friction"},
+ {"type": "add", "id": "colebrook"}, {"type": "solve"}, {"type": "declare", "status": "outside_validity"}]
+ state = {}
+
+ def m1_like(batch):
+ out = []
+ for m in batch:
+ obs = json.loads(m[1]["content"])
+ key = json.dumps(obs["problem"], sort_keys=True)
+ if "flow:pipe" in obs["problem"]["context"]:
+ i = state.setdefault(key, 0)
+ state[key] = i + 1
+ out.append(json.dumps(crash_seq[min(i, len(crash_seq) - 1)]))
+ else:
+ out.append(json.dumps(state.setdefault(key, ConstructorPolicy()).act(obs)))
+ return out
+
+ class Backend:
+ def generator(self, gen):
+ return m1_like
+ saved = run_policy("model", ts[:5], ConstructorPolicy, "llm:m1") # work finished before the crash
+ (tmp_path / "model_seen__m1.trajectories.jsonl").write_text("".join(json.dumps(e, sort_keys=True) + "\n" for e in saved))
+ rep = eg.run_env_suite(Backend(), "m1", "model_seen", ts, tmp_path, batch=8)
+ assert rep["revalidation"]["kept"] == 5 and rep["llm"]["tasks"] == len(ts) == 40
+ assert rep["llm"]["infra_errors"] == 0
+ pipe_eps = [json.loads(x) for x in (tmp_path / "model_seen__m1.trajectories.jsonl").read_text().splitlines()
+ if x.startswith('{') and '"pipe_' in x.split('"task"')[1][:30]]
+ assert len(pipe_eps) == 12
+ assert all(e["trajectory"][3]["action"] == {"type": "solve"} for e in pipe_eps)
+ assert all(e["trajectory"][4]["obs"]["last_solve"]["status"] == "invalid_domain" for e in pipe_eps)
+ eg.write_summary(tmp_path, [rep], {"model_seen": eg.references("model_seen", ts)})
+ md = (tmp_path / "summary.md").read_text()
+ assert "Scoring policy" in md and "| m1 | 40 | 40 | 0 |" in md and "*constructor*" in md
