diff --git a/tests/test_no_progress_guard.py b/tests/test_no_progress_guard.py
new file mode 100644
index 0000000..824c239
--- /dev/null
+++ b/tests/test_no_progress_guard.py
@@ -0,0 +1,195 @@
+"""ADR-027: ModelEnv no-progress guard, corrective feedback, prompt versions and loop diagnostics.
+
+Reproduces the real M1 failure (model_seen, beam_underdetermined#0: search delta, add the cantilever deflection
+fragment, solve, then solve again until the 40-step budget ran out) and pins that the guard only ends loops: it
+never declares, never rewards repetition, and never fires on a solve after a real model change.
+"""
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+from berkelium.agent.batch_runner import run_batched, run_policy
+from berkelium.agent.model_env import ModelEnv
+from berkelium.agent.model_policies import PROMPTS, ConstructorPolicy, LLMModelPolicy, model_messages
+from berkelium.agent.model_tasks import tasks
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+
+TS = {t.id: t for t in tasks(4, seed=0)}
+BEAM = TS["beam_underdetermined#0"]
+SETUP = [{"type": "search", "var": "delta"}, {"type": "add", "id": "cantilever_end_load_deflection"},
+         {"type": "solve"}]
+SOLVE = {"type": "solve"}
+
+
+def run(env, actions):
+    out = []
+    for a in actions:
+        if env.done:
+            break
+        out.append(env.step(a))
+    return out
+
+
+def test_m1_beam_loop_is_stopped_well_before_the_budget():
+    env = ModelEnv(BEAM, 40)
+    res = run(env, SETUP + [SOLVE] * 37)          # the recorded M1 episode: solve until the budget is gone
+    assert env.last_solve["status"] == "underdetermined"
+    obs, r, done, info = res[-1]
+    assert done and info["outcome"] == "no_progress" and r == -1.0
+    assert env.steps == 3 + env.no_progress_stop < 40
+    st = info["no_progress"]
+    assert st == {"no_progress_actions": 5, "warnings": 3, "max_streak": 5, "recovered": False, "stopped": True}
+    assert [x[1] for x in res[:-1]] == [0.0] * (len(res) - 1)        # repetition never earns reward
+
+
+def test_feedback_appears_at_threshold_and_names_the_unchanged_status():
+    env = ModelEnv(BEAM, 40)
+    res = run(env, SETUP + [SOLVE, SOLVE])
+    assert "feedback" not in res[2][0] and "feedback" not in res[3][0]   # first repeat: tolerated silently
+    fb = res[4][0]["feedback"]
+    assert fb["no_progress"] == 2 and fb["solver_status"] == "underdetermined"
+    assert "specify 1 of ['I', 'delta']" in fb["solver_diagnostics"]
+    assert "3 more action(s)" in fb["message"]
+
+
+def test_recovery_by_meaningful_change_resets_the_streak():
+    env = ModelEnv(BEAM, 40)
+    res = run(env, SETUP + [SOLVE, SOLVE, SOLVE, {"type": "search", "var": "I"}])
+    assert "feedback" in res[5][0] and "feedback" not in res[6][0]
+    assert env._streak == 0 and not env.done
+    assert env.loop_stats()["recovered"] is True
+    run(env, [SOLVE])            # the MODEL is still unchanged (only the search moved): counted, streak 1, not fatal
+    assert env.loop_stats()["no_progress_actions"] == 4 and env._streak == 1 and not env.done
+
+
+def test_solve_after_real_model_change_is_never_no_progress():
+    t = TS["beam_cantilever_deflection#0"]
+    env = ModelEnv(t, 40)
+    pol = ConstructorPolicy()
+    obs = env.observe()
+    plan = []
+    while not env.done:
+        a = pol.act(obs)
+        plan.append(a)
+        obs, *_ = env.step(a)
+    adds = [a for a in plan if a["type"] == "add"]
+    env2 = ModelEnv(t, 40)
+    run(env2, [plan[0]] + [x for a in adds for x in (a, SOLVE)])   # solve after every add
+    assert env2.loop_stats()["no_progress_actions"] == 0
+
+
+def test_valid_underdetermined_declaration_is_correct_with_or_without_a_warning():
+    env = ModelEnv(BEAM, 40)
+    _, r, done, info = run(env, SETUP + [{"type": "declare", "status": "underdetermined"}])[-1]
+    assert done and info["outcome"] == "correct" and r == pytest.approx(1 - 0.02 * 4)
+    assert info["no_progress"]["warnings"] == 0
+    env = ModelEnv(BEAM, 40)
+    _, r2, _, info2 = run(env, SETUP + [SOLVE, SOLVE, {"type": "declare", "status": "underdetermined"}])[-1]
+    assert info2["outcome"] == "correct" and info2["no_progress"]["recovered"] is True
+    assert r2 < r                                   # looping first costs steps: no artificial bonus
+
+
+def test_guard_never_declares_for_the_agent():
+    env = ModelEnv(BEAM, 40)                        # truth is underdetermined and the solve says so,
+    _, r, _, info = run(env, SETUP + [SOLVE] * 10)[-1]   # but the agent never declared -> not correct
+    assert info["outcome"] == "no_progress" and r < 0
+
+
+@pytest.mark.parametrize("tid,status", [("beam_cantilever_deflection#0", "determined"),
+                                        ("beam_contradictory_mass#0", "contradictory"),
+                                        ("pipe_transitional_dp#0", "outside_validity")])
+def test_determined_contradictory_invalid_cases_unchanged_for_the_constructor(tid, status):
+    env, pol = ModelEnv(TS[tid], 40), ConstructorPolicy()
+    obs, info = env.observe(), {}
+    while not env.done:
+        obs, r, d, info = env.step(pol.act(obs))
+        assert "feedback" not in obs
+    assert TS[tid].truth_status == status and info["outcome"] == "correct"
+    assert info["no_progress"]["no_progress_actions"] == 0
+
+
+def test_repeated_solve_on_a_determined_model_stops_without_credit():
+    tid = "beam_cantilever_deflection#0"
+    env, pol = ModelEnv(TS[tid], 40), ConstructorPolicy()
+    obs = env.observe()
+    while env.last_solve.get("status") != "solved":
+        obs, *_ = env.step(pol.act(obs))
+    _, r, done, info = run(env, [SOLVE] * 10)[-1]
+    assert done and info["outcome"] == "no_progress" and r == -1.0
+
+
+def test_constructor_matches_recorded_e5_episodes_exactly():
+    """The teacher never repeats a state, so r2 observations/actions/rewards equal the recorded r1 episodes."""
+    rec = [json.loads(x) for x in Path("docs/experiments/trajectories_e5.jsonl").read_text().splitlines()]
+    rec = {e["task"]: e for e in rec if e["policy"] == "constructor"}
+    assert len(rec) == 68
+    now = {e["task"]: e for e in run_policy("model", list(TS.values()), ConstructorPolicy, "constructor")}
+    for tid, e in rec.items():
+        n = now[tid]
+        assert (n["outcome"], n["return"], n["steps"]) == (e["outcome"], e["return"], e["steps"]), tid
+        assert n["trajectory"] == e["trajectory"], tid
+        assert n["no_progress"]["no_progress_actions"] == 0
+
+
+def test_trained_prompt_is_byte_identical_and_guided_extends_it():
+    obs = ModelEnv(BEAM, 40).observe()
+    assert PROMPTS["trained"] is LLMModelPolicy.SYSTEM
+    assert model_messages(obs) == model_messages(obs, "trained")
+    assert model_messages(obs)[0]["content"] == LLMModelPolicy.SYSTEM
+    g = model_messages(obs, "guided")[0]["content"]
+    assert g.startswith(LLMModelPolicy.SYSTEM) and "'underdetermined'" in g and "feedback" in g
+    assert model_messages(obs, "guided")[1] == model_messages(obs)[1]
+
+
+def _looping_generator(seen):
+    """Stands in for M1: replays the recorded beam pattern, then 'solve' forever; records the prompts."""
+    def gen(batch):
+        out = []
+        for msgs in batch:
+            seen.append(msgs[0]["content"])
+            obs = json.loads(msgs[1]["content"])
+            step = 40 - obs["steps_left"]
+            out.append(json.dumps(SETUP[step] if step < 3 else SOLVE))
+        return out
+    return gen
+
+
+def test_batch_runner_loop_ends_as_model_failure_not_infra_and_reports_render(tmp_path):
+    import eval_generations as eg
+    seen = []
+    from functools import partial
+    eps = run_batched("model", [BEAM, TS["beam_underdetermined#1"]], _looping_generator(seen), "llm:fake+guided",
+                      batch_size=2, messages=partial(model_messages, prompt="guided"))
+    assert {e["outcome"] for e in eps} == {"no_progress"} and all(e["steps"] == 8 for e in eps)
+    assert all("infra_error" not in e for e in eps)
+    assert seen and all(s == PROMPTS["guided"] for s in seen)
+    m = eg.summarize("model_seen", eps)
+    assert m["infra_errors"] == 0 and m["outcomes"] == {"no_progress": 2}
+    assert m["no_progress"] == {"actions": 10, "warnings": 6, "episodes_warned": 2, "recovered": 0, "stopped": 2}
+    claim_ts = __import__("agent_llm_eval").select("heldout")[:2]
+    from berkelium.agent.policies import CheapestSufficient
+    mc = eg.summarize("claim", run_policy("claim", claim_ts, CheapestSufficient, "cheapest_sufficient"))
+    assert "no_progress" not in mc
+    reports = [{"generation": "fake", "suite": "claim", "llm": mc},
+               {"generation": "fake", "suite": "model_seen", "llm": m}]
+    eg.write_summary(tmp_path, reports, {})
+    md = (tmp_path / "summary.md").read_text()
+    assert "- no-progress (fake): 10 actions, 6 warnings in 2 episodes, 0 recovered, 2 stopped" in md
+
+
+def test_resume_reruns_episodes_from_another_prompt(tmp_path):
+    from functools import partial
+
+    import eval_generations as eg
+    eps = run_batched("model", [BEAM], _looping_generator([]), "llm:m1", batch_size=1,
+                      messages=partial(model_messages, prompt="trained"))
+    traj = tmp_path / "t.jsonl"
+    traj.write_text(json.dumps(eps[0], default=str) + "\n")
+    have, reval = eg.load_validated(traj, "model", [BEAM], "[t]", eg.policy_name("m1", "model", "guided"))
+    assert not have and reval["rerun_other_policy"] == [BEAM.id]
+    have, reval = eg.load_validated(traj, "model", [BEAM], "[t]", eg.policy_name("m1", "model", "trained"))
+    assert list(have) == [BEAM.id] and reval["kept"] == 1
